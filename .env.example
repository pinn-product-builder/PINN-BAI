# Copie para .env e preencha com os valores do projeto Supabase.
# Ver: Dashboard do projeto → Settings → API

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Backend API
VITE_BACKEND_URL=http://localhost:8000

# ── Mari v2 (LinkedIn SDR) ─────────────────────────────────────────────────
# Projeto Supabase DEDICADO da Mari v2 (separado do BAI).
# Sem essas envs, a tela /linkedin-sdr da Pinn fica vazia — os hooks retornam [].
# Pegue em: Dashboard do projeto Mari → Settings → API.
VITE_MARI_SUPABASE_URL="https://YOUR-MARI-PROJECT-REF.supabase.co"
VITE_MARI_SUPABASE_KEY="YOUR-MARI-ANON-KEY"
