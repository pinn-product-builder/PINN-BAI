# Copie para `.env` na raiz e preencha (dev local com `npm run dev` + `npm run dev:api`).
# Supabase: Dashboard → Settings → API

VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-key"

# Opcional — segundo projeto Supabase (Mari SDR). Sem isso a aba Mari mostra métricas zeradas.
# VITE_MARI_SUPABASE_URL="https://xxxx.supabase.co"
# VITE_MARI_SUPABASE_KEY="eyJ..."

# Google Maps JS API (usada na demo Arguto / pinn-bai → /client/:orgId/arguto).
# Crie a key no GCP, restringe a "Maps JavaScript API" e a referers localhost + domínio prod.
# VITE_GOOGLE_MAPS_API_KEY="AIza..."

# API HTTP: em dev, deixe vazio — o Vite faz proxy de `/api` para localhost:8787.
# Na VPS com Docker (Nginx no mesmo host), também deixe vazio para usar `/api` relativo.
# VITE_API_URL=https://api.seudominio.com

# --- Deploy Docker na VPS: use também `deploy.env.example` → copie para `.env` na raiz
# e rode `npm run docker:up` (sobe web + api). Ver docs/DEPLOY_VPS.md.
