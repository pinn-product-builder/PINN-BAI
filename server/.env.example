PORT=8787
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
# Opcional — só para scripts/jobs futuros; as rotas CRM usam JWT do usuário (RLS).
# SUPABASE_SERVICE_ROLE_KEY=
# Opcional — quando definido, sync exige CRM conectado (modo live)
COMPOSIO_API_KEY=
# Execução das tools KOMMO_* (igual crm-auditor-standalone / kommo_composio.py)
# COMPOSIO_EXECUTE_BASE_URL=https://backend.composio.dev/api/v3.1
# Auth Config do Kommo no painel Composio (mesmo Auth Config do app que já usa Kommo via Composio)
COMPOSIO_KOMMO_AUTH_CONFIG_ID=
# Opcional: mesmo `user_id`/entidade na Composio que o outro sistema usa (`{orgId}` = UUID da org).
# Ex.: só o UUID → {orgId}   |   prefixo → bf-org-{orgId}
# COMPOSIO_USER_ID_TEMPLATE=pinn-org-{orgId}
# Opcional (igual auditor standalone): conta e user fixos — sync funciona sem OAuth no CRM_CONNECTIONS
# COMPOSIO_CONNECTED_ACCOUNT_ID=
# COMPOSIO_USER_ID=
# Dias para considerar lead aberto “parado” (default 7)
# AUDITOR_STUCK_LEAD_DAYS=7
# URL do front após OAuth (callback Composio → usuário volta ao PINN). Dev: http://localhost:8080
PUBLIC_APP_URL=http://localhost:8080
# Origens permitidas no CORS (várias separadas por vírgula). Em dev: http://localhost:8080
# Pode usar CORS_ORIGINS=... (nome do auditor standalone) em vez de CORS_ORIGIN.
CORS_ORIGIN=http://localhost:8080
