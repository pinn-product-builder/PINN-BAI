# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Servidor
PORT=8000
ENVIRONMENT=development

# CORS — domínios permitidos (separados por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Kommo (para testes locais sem banco)
KOMMO_ACCESS_TOKEN=
KOMMO_SUBDOMAIN=

# BAI CRM Auditor — LLM (opcional; sem chave, relatório determinístico)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Leads “parados” após N dias sem atualização
AUDITOR_STUCK_LEAD_DAYS=7
# Máx. páginas (×250 itens) por stream em notas/eventos/conversas no sync
AUDITOR_ENGAGEMENT_MAX_PAGES=20

# ── Email Outreach ───────────────────────────────────────────────────────────
# Chave Fernet (32 bytes base64) para criptografar tokens OAuth e senhas SMTP.
# Gerar: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EO_ENCRYPTION_KEY=

# (Opcional) Secret separado para assinar o state do OAuth.
# Se omitido, EO_ENCRYPTION_KEY é reutilizada.
EO_OAUTH_STATE_SECRET=

# Google Cloud Console → OAuth 2.0 Client ID (Web application).
# Authorized redirect URI: http://localhost:8000/email/oauth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/email/oauth/google/callback

# Microsoft (E5) — preencher quando ativar Outlook OAuth.
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=http://localhost:8000/email/oauth/microsoft/callback

# URL base do frontend BAI (usada para redirects após OAuth, se preferir).
BAI_FRONTEND_URL=http://localhost:5173

# Healthcheck periódico das inboxes EO (em minutos).
EO_HEALTHCHECK_INTERVAL_MINUTES=60
