# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Servidor
PORT=8000
ENVIRONMENT=development

# CORS — domínios permitidos (separados por vírgula)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Kommo (para testes locais sem banco)
KOMMO_ACCESS_TOKEN=
KOMMO_SUBDOMAIN=

# BAI CRM Auditor — Composio (API key do projeto; sync real usa Kommo HTTP com token na conexão)
COMPOSIO_API_KEY=
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v3
# Execução de tools (Kommo via Composio)
COMPOSIO_EXECUTE_BASE_URL=https://backend.composio.dev/api/v3.1
# true = dados demo | false = Composio (connected account) ou Kommo HTTP direto
COMPOSIO_MOCK_SYNC=true

# BAI CRM Auditor — LLM (opcional; sem chave, relatório determinístico)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Leads “parados” após N dias sem atualização
AUDITOR_STUCK_LEAD_DAYS=7
# Máx. páginas (×250 itens) por stream em notas/eventos/conversas no sync
AUDITOR_ENGAGEMENT_MAX_PAGES=20
