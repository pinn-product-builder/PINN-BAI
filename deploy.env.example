# Copie para `.env` na raiz do repositório e use com:
#   docker compose --env-file .env up -d --build
#
# --- Supabase (Dashboard → Settings → API) ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
# Opcional na API (CRM Auditor usa JWT + RLS). Mantenha vazio salvo jobs administrativos futuros.
# SUPABASE_SERVICE_ROLE_KEY=

# Mesmos valores do anon/public key do Supabase, para o build do Vite (frontend)
VITE_SUPABASE_URL=https://xxxxxxxx.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Opcional: Composio (CRM Auditor modo live — OAuth Kommo via Link API)
COMPOSIO_API_KEY=
# ID do Auth Config Kommo no dashboard Composio
COMPOSIO_KOMMO_AUTH_CONFIG_ID=
# URL pública do SPA (callback após OAuth). Ex.: https://app.seudominio.com
PUBLIC_APP_URL=

# Origens permitidas no CORS da API (separadas por vírgula).
# Com docker-compose atual, o browser fala com o mesmo domínio via Nginx — pode usar a URL pública do site:
# CORS_ORIGIN=https://app.seudominio.com
CORS_ORIGIN=

# Porta no host onde o Nginx servirá o SPA (padrão 80)
WEB_HOST_PORT=80

# Em geral deixe vazio: o frontend usa URLs relativas /api e o Nginx encaminha para o container `api`.
# Só preencha se o front for servido em outro domínio que chama a API diretamente:
# VITE_API_URL=https://api.seudominio.com

# Mari v2 — LinkedIn SDR / campanhas (projeto Supabase da Mari; injetado no build do Vite)
# Use a mesma URL e key anon do .env da Mari (SUPABASE_URL / SUPABASE_KEY).
VITE_MARI_SUPABASE_URL=
VITE_MARI_SUPABASE_KEY=

# Google Maps JS API (demo Arguto / pinn-bai → /client/:orgId/arguto)
# Crie a key no GCP, restrinja a "Maps JavaScript API" e adicione referrers:
#   https://bai.pinnpb.com/*
#   https://bai.srv879715.hstgr.cloud/*
VITE_GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Backend Python (FastAPI) — service `backend` no docker-compose
# ─────────────────────────────────────────────────────────────────────────────
# O backend Python concentra CRM Auditor, Customer Health, KPI, Ads e o motor
# de Email Outreach. Roda em http://backend:8000 dentro da rede do compose; o
# Nginx do service `web` faz proxy de /email/, /crm/, /hub/, /ads/, /kpi/ e
# /webhook/ pra ele. Em produção, o SPA chama estas rotas via mesmo domínio
# (recomendado: defina VITE_BACKEND_URL="" pra usar caminhos relativos).
PY_ENV=production
# CORS — separados por vírgula. Em produção com proxy reverso do Nginx, "*" é OK
# porque o navegador só fala com bai.pinnpb.com (mesma origem).
PY_CORS_ORIGINS=*

# Frontend chamando o backend via mesmo domínio (proxy do Nginx). Deixe VAZIO.
VITE_BACKEND_URL=

# ── Email Outreach ──────────────────────────────────────────────────────────
# Chave Fernet de 32 bytes base64 — criptografa tokens OAuth e senhas SMTP
# armazenados em eo_inboxes. NUNCA mudar sem rotacionar dados existentes.
# Gere uma vez:
#   docker run --rm python:3.12-slim python -c \
#     "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EO_ENCRYPTION_KEY=

# (Opcional) secret HMAC do state do OAuth. Se vazio, reusa EO_ENCRYPTION_KEY.
EO_OAUTH_STATE_SECRET=

# Periodicidade do job de healthcheck das inboxes conectadas.
EO_HEALTHCHECK_INTERVAL_MINUTES=60

# ── Google OAuth (Gmail) ────────────────────────────────────────────────────
# Crie em Google Cloud Console → APIs & Services → Credentials → OAuth client ID
# (tipo "Web application"). Authorized redirect URI deve casar EXATAMENTE:
#   https://bai.pinnpb.com/email/oauth/google/callback
# OAuth consent screen → tipo "Internal" se for Workspace @pinnpb.com.
# Ative a API: Gmail API (APIs & Services → Library).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://bai.pinnpb.com/email/oauth/google/callback

# ── Microsoft Graph (Outlook) — Sprint 7 ─────────────────────────────────────
# Azure Portal → App registrations. Redirect URI:
#   https://bai.pinnpb.com/email/oauth/microsoft/callback
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_REDIRECT_URI=https://bai.pinnpb.com/email/oauth/microsoft/callback

# URL pública do SPA (usada em alguns redirects opcionais).
BAI_FRONTEND_URL=https://bai.pinnpb.com
